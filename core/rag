from pathlib import Path
import re
from sklearn.feature_extraction.text import TfidfVectorizer
from sklearn.metrics.pairwise import cosine_similarity

class PolicyRAG:
    """Small local RAG layer for a hackathon: chunk policy text and retrieve by semantic TF-IDF similarity."""
    def __init__(self, policy_path: str):
        text = Path(policy_path).read_text(encoding="utf-8")
        self.chunks = [c.strip() for c in re.split(r"\n\s*\n", text) if c.strip()]
        self.vectorizer = TfidfVectorizer(stop_words="english", ngram_range=(1, 2))
        self.matrix = self.vectorizer.fit_transform(self.chunks)

    def retrieve(self, query: str, k: int = 4):
        q = self.vectorizer.transform([query])
        scores = cosine_similarity(q, self.matrix).flatten()
        idxs = scores.argsort()[::-1][:k]
        return [
            {"text": self.chunks[i], "score": float(scores[i]), "source": "company_policy.txt"}
            for i in idxs if scores[i] > 0
        ]

